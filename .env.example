# 在 https://console.groq.com/keys 创建；只填写到 .env.local，切勿使用 NEXT_PUBLIC_ 前缀。
GROQ_API_KEY=

# Ondoku HiuGaai 朗读，仅服务端使用；在 Ondoku 设置中获取。
ONDOKU_TOKEN=

# 翻译/转写服务：groq（默认）或 siliconflow（备用）。切换后重启服务。
AI_PROVIDER=groq
# https://cloud.siliconflow.cn/ 获取，仅服务端使用。
SILICONFLOW_API_KEY=

# 本服务器每日上限（香港时间重置），0 为停用；失败/取消的已发出请求也计数。
DAILY_TRANSLATE_LIMIT=100
DAILY_TRANSCRIBE_LIMIT=20
DAILY_TTS_LIMIT=100
DAILY_TTS_CHARACTER_LIMIT=10000
# 统计存储目录需可写且持久保留；默认项目下 .data/，多实例需改用共享数据库。
# SERVICE_DATA_DIR=/absolute/persistent/path

# v2.1：Project URL 和 Publishable Key（不要填 Secret / service_role）
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
